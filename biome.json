{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "single", "trailingCommas": "none" }
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true, "suspicious": { "noExplicitAny": "warn" } }
  },
  "files": {
    "ignore": ["dist", "node_modules", "test/visual/out", "test/perf/out"]
  }
}
