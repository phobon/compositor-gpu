{
  "name": "compositor-gpu",
  "version": "0.0.1",
  "description": "Mirror a live DOM onto the GPU \u2014 boxes, images, and Slug-rendered text \u2014 kept in step with the page.",
  "type": "module",
  "license": "MIT",
  "author": "Bonobo",
  "repository": {
    "type": "git",
    "url": "https://github.com/phobon/compositor-gpu.git"
  },
  "sideEffects": [
    "./src/util/env.ts"
  ],
  "main": "./dist/compositor-gpu.js",
  "module": "./dist/compositor-gpu.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/compositor-gpu.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write .",
    "test:visual": "tsx test/visual/run.ts",
    "test:perf": "tsx test/perf/run.ts",
    "test:site": "tsx test/site/run.ts"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "typegpu": "^0.12.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/opentype.js": "^1.3.10",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@typescript/typescript6": "^6.0.2",
    "@webgpu/types": "^0.1.74",
    "dejavu-fonts-ttf": "^2.37.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1"
  }
}
