{
  "name": "compositor-gpu",
  "version": "0.0.1",
  "description": "Mirror a live DOM onto the GPU — boxes, images, and Slug-rendered text — kept in step with the page.",
  "type": "module",
  "license": "MIT",
  "author": "Bonobo",
  "repository": {
    "type": "git",
    "url": "https://github.com/phobon/compositor-gpu.git"
  },
  "sideEffects": [
    "./src/util/env.ts"
  ],
  "main": "./dist/compositor-gpu.js",
  "module": "./dist/compositor-gpu.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/compositor-gpu.js"
    },
    "./fx": {
      "types": "./dist/fx/index.d.ts",
      "import": "./dist/fx.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./dials": {
      "types": "./dist/dials/index.d.ts",
      "import": "./dist/dials.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write .",
    "test:visual": "tsx test/visual/run.ts",
    "test:perf": "tsx test/perf/run.ts",
    "test:fx": "tsx test/fx/run.ts",
    "test:site": "tsx test/site/run.ts",
    "test:profile": "tsx test/profile/run.ts",
    "test:budget": "tsx test/profile/run.ts --morph --headed --dpr 2",
    "test:atlas": "tsx test/atlas/run.ts",
    "test:edit": "tsx test/edit/run.ts",
    "test:round": "bash test/round.sh",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "profile": "tsx tools/profile.ts",
    "bake": "tsx tools/bake.ts",
    "bake:playground": "tsx tools/bake.ts playground/compositor-gpu.bake.json"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "typegpu": "^0.12.8"
  },
  "peerDependencies": {
    "dialkit": ">=2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "dialkit": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/opentype.js": "^1.3.10",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@webgpu/types": "^0.1.74",
    "dejavu-fonts-ttf": "^2.37.3",
    "dialkit": "^2.0.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-typegpu": "0.12.6",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
