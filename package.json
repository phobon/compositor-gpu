{
  "name": "compositor-gpu",
  "version": "0.0.1",
  "description": "Mirror a live DOM onto the GPU — boxes, images, and Slug-rendered text — kept in step with the page.",
  "type": "module",
  "license": "MIT",
  "author": "Bonobo",
  "repository": {
    "type": "git",
    "url": "https://github.com/phobon/compositor-gpu.git"
  },
  "sideEffects": false,
  "main": "./dist/compositor-gpu.js",
  "module": "./dist/compositor-gpu.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/compositor-gpu.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write .",
    "test:visual": "tsx test/visual/run.ts"
  },
  "dependencies": {
    "opentype.js": "^1.3.5",
    "typegpu": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/opentype.js": "^1.3.8",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.51",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0"
  }
}
